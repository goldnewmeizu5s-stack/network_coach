generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String   @id @default(uuid())
  name             String   @default("User")
  goals            String?
  fears            String?
  strengths        String?
  weaknesses       String?
  current_country  String?
  preferences      Json?
  pin_hash         String?
  telegram_chat_id String?
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt
}

model Contact {
  id                  String    @id @default(uuid())
  full_name           String
  nickname            String?
  photo_url           String?
  where_met           String?
  met_date            DateTime?
  occupation          String?
  company             String?
  city                String?
  country             String?
  met_country         String?
  origin_country      String?
  key_interests       String[]
  what_impressed_me   String?
  potential_synergies String?
  personality_notes   String?
  memory_summary      String?
  relationship_category String?
  social_links        Json?
  memory_notes        String[]
  personal_notes      String?
  warmth_status       String   @default("new")
  warmth_score        Float    @default(0)
  urgency_score       Int      @default(5)
  location_status     String?
  last_interaction_at DateTime?
  interest_tier       String   @default("active")
  interest_score      Float    @default(50)
  interest_decayed_at DateTime @default(now())
  tier_locked         Boolean  @default(false)
  last_goal_event_at  DateTime?
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  interactions   Interaction[]
  follow_ups     FollowUp[]
  interest_goals InterestGoal[]
  growth_edge    GrowthEdge?

  @@index([warmth_status])
  @@index([last_interaction_at])
  @@index([created_at])
  @@index([warmth_status, last_interaction_at])
  @@index([interest_tier])
  @@index([interest_tier, last_interaction_at])
}

model Interaction {
  id         String   @id @default(uuid())
  contact_id String?
  contact    Contact?  @relation(fields: [contact_id], references: [id], onDelete: Cascade)
  type       String
  content    String?
  transcript String?
  ai_summary String?
  created_at DateTime @default(now())

  audio_file AudioFile?

  @@index([contact_id, created_at])
  @@index([created_at])
}

model InterestGoal {
  id                          String    @id @default(uuid())
  contact_id                  String
  contact                     Contact   @relation(fields: [contact_id], references: [id], onDelete: Cascade)
  description                 String
  status                      String    @default("open")
  source                      String    @default("ai")
  created_at                  DateTime  @default(now())
  satisfied_at                DateTime?
  satisfied_by_interaction_id String?
  last_mentioned_at           DateTime  @default(now())

  @@index([contact_id, status])
  @@index([status, last_mentioned_at])
}

// Per-contact "growth edge" assessment — the chess-theory filter:
// in which plane is this person stronger than the user, what to absorb,
// and how aggressively to invest. One row per contact, re-computable.
model GrowthEdge {
  id          String   @id @default(uuid())
  contact_id  String   @unique
  contact     Contact  @relation(fields: [contact_id], references: [id], onDelete: Cascade)
  verdict     String   @default("unclear") // "sensei" | "peer" | "giver" | "unclear"
  headline    String
  planes      Json     @default("[]") // GrowthPlane[]: { plane, why, how_to_absorb }
  chess_note  String?
  priority    Int      @default(0) // 0-100 growth-investment priority
  status      String   @default("active") // "active" | "dismissed"
  analyzed_at DateTime @default(now())
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@index([status, priority])
  @@index([verdict])
  @@index([analyzed_at])
}

model AudioFile {
  id                   String      @id @default(uuid())
  interaction_id       String      @unique
  interaction          Interaction @relation(fields: [interaction_id], references: [id], onDelete: Cascade)
  file_path            String
  duration_seconds     Int?
  transcription_status String      @default("pending")
  created_at           DateTime    @default(now())

  @@index([transcription_status])
}

model FollowUp {
  id               String    @id @default(uuid())
  contact_id       String
  contact          Contact   @relation(fields: [contact_id], references: [id], onDelete: Cascade)
  suggested_action String
  due_date         DateTime
  status           String    @default("pending")
  // "auto" = generated by the AI/engine (safe to auto-cancel on re-evaluation),
  // "user" = explicitly created/kept by the user (never auto-cancelled).
  source           String    @default("auto")
  priority         Int       @default(5)
  snoozed_until    DateTime?
  completed_at     DateTime?
  created_at       DateTime  @default(now())

  @@index([status, due_date])
  @@index([contact_id, status])
}

model Challenge {
  id                     String       @id @default(uuid())
  date                   DateTime     @default(now())
  title                  String
  description            String
  category               String
  difficulty             Int          @default(5)
  tier                   String       @default("normal") // "quick", "normal", "stretch"
  methodology_id         String?
  methodology            Methodology? @relation(fields: [methodology_id], references: [id])
  status                 String       @default("pending")
  reflection             String?
  rating                 Int?
  xp_earned              Int          @default(0)
  estimated_time_minutes Int?
  is_bonus               Boolean      @default(false)
  is_location_based      Boolean      @default(false)
  location_context       String?
  context_tags           String[]
  dating_flavor          Boolean      @default(false)
  created_at             DateTime     @default(now())
  completed_at           DateTime?

  @@index([date])
  @@index([status, date])
  @@index([is_location_based, date])
}

model Methodology {
  id                String   @id @default(uuid())
  source            String
  title             String
  core_principle    String
  full_text         String
  application_steps String?
  when_to_use       String?
  tags              String[]
  created_at        DateTime @default(now())

  challenges Challenge[]
}

model ChatMessage {
  id         String   @id @default(uuid())
  role       String
  content    String
  metadata   Json?
  created_at DateTime @default(now())

  @@index([created_at])
}

model Session {
  id         String   @id @default(uuid())
  token      String   @unique
  expires_at DateTime
  created_at DateTime @default(now())

  @@index([token])
  @@index([expires_at])
}

model Note {
  id         String   @id @default(uuid())
  title      String?
  body       String
  tags       String[]
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  links NoteLink[] @relation("note_from")

  @@index([created_at])
  @@index([updated_at])
}

model NoteLink {
  id           String   @id @default(uuid())
  from_note_id String
  from_note    Note     @relation("note_from", fields: [from_note_id], references: [id], onDelete: Cascade)
  target_type  String   // "contact" | "note"
  target_id    String
  label        String?
  created_at   DateTime @default(now())

  @@unique([from_note_id, target_type, target_id])
  @@index([target_type, target_id])
  @@index([from_note_id])
}
